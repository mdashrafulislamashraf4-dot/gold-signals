# ====================================================
# AI GOLD SIGNAL SYSTEM - Configuration
# সব API Key এবং সেটিংস এখানে দিন
# ====================================================

# ---------- TELEGRAM BOT ----------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
# একাধিক Chat ID হলে comma দিয়ে আলাদা করুন
# TELEGRAM_CHAT_ID=12345,67890

# ---------- GOOGLE GEMINI AI ----------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ---------- NEWS API (Free: newsapi.org) ----------
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE

# ---------- ALPHA VANTAGE (Free: alphavantage.co) ----------
ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY_HERE

# ---------- SYSTEM SETTINGS ----------
# Timezone (Bangladesh = Asia/Dhaka)
TIMEZONE=Asia/Dhaka

# Signal Check Interval (minutes)
SIGNAL_CHECK_INTERVAL=15

# Risk per trade (%)
RISK_PER_TRADE=2

# Minimum signal confidence to send (%)
MIN_CONFIDENCE=65

# Daily report time (24hr format)
DAILY_REPORT_TIME=23:59

# ---------- TRADING SETTINGS ----------
# Gold Symbol
GOLD_SYMBOL=GC=F

# Timeframes to analyze
TIMEFRAMES=1h,4h,1d

# ---------- DATABASE ----------
DB_PATH=database/signals.db
