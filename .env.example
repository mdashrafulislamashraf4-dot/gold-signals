# ====================================================
# AI GOLD (XAUUSD) SCALPING SIGNAL BOT — Environment Configuration
# ====================================================

# ---------- OPERATING MODE & SAFETY ----------
# Modes: BACKTEST | PAPER | LIVE
# (LIVE is disabled by default; requires explicit authorization)
OPERATING_MODE=PAPER
LIVE_EXECUTION_AUTHORIZED=False
KILL_SWITCH_ACTIVE=False

# ---------- TELEGRAM BOT ----------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
# Multiple IDs separated by commas:
# TELEGRAM_CHAT_ID=12345678,87654321

# ---------- GOOGLE GEMINI AI ----------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ---------- NEWS API (Free: newsapi.org) ----------
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE

# ---------- ALPHA VANTAGE (Free: alphavantage.co) ----------
ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY_HERE

# ---------- WEBHOOK SECURITY ----------
WEBHOOK_SECRET=xauusd-smc-secret-key-2026

# ---------- SYSTEM SETTINGS ----------
TIMEZONE=Asia/Dhaka
SIGNAL_CHECK_INTERVAL=5
NEWS_CHECK_INTERVAL_SECONDS=30
MIN_CONFIDENCE=65
DAILY_REPORT_TIME=23:59

# ---------- DYNAMIC RISK & POSITION SIZING ----------
# Default risk per trade: 0.25% (Absolute ceiling: 0.50%)
RISK_PER_TRADE=0.25
MAX_DAILY_LOSS_PCT=1.0
ENABLE_CONSECUTIVE_LOSS_LIMIT=False
MAX_CONSECUTIVE_LOSSES=0
MAX_SIMULTANEOUS_POSITIONS=1
COOLDOWN_MINUTES_AFTER_SL=30
MAX_SPREAD_ALLOWED=0.45
VOLATILITY_SPIKE_THRESHOLD_ATR_MULT=2.5

# ---------- ECONOMIC NEWS BLACKOUT ----------
NEWS_BLACKOUT_MINUTES_BEFORE=15
NEWS_BLACKOUT_MINUTES_AFTER=15

# ---------- DYNAMIC TARGET & EXIT RULES ----------
# Scalping targets are calculated from structure (1.0R - 1.5R default, 2R if supported)
# Never forces fixed 1:5 targets!
MIN_RR_RATIO=1.0
ENABLE_BREAK_EVEN=True
BREAK_EVEN_TRIGGER_R=1.0
ENABLE_TRAILING_STOP=False
TRAILING_TRIGGER_R=1.5

# ---------- BROKER CONTRACT SPECIFICATIONS (XAUUSD) ----------
BROKER_NAME=OANDA / Standard CFD
BROKER_LOT_SIZE=100.0
BROKER_MIN_LOT=0.01
BROKER_LOT_STEP=0.01
BROKER_POINT_VALUE=1.0
COMMISSION_PER_LOT=4.0
ESTIMATED_SLIPPAGE_POINTS=0.05
PAPER_INITIAL_BALANCE=10000.0

# ---------- DATABASE ----------
DB_PATH=database/signals.db
